{
  "name": "bss-design-system",
  "private": true,
  "type": "module",
  "description": "BSS 디자인 시스템: Figma에서 뽑은 component.json으로 만든 React 컴포넌트와 디자인 포털 문서 사이트",
  "scripts": {
    "gen": "node scripts/gen-react.mjs",
    "dev": "npm run gen && vite",
    "build": "npm run gen && tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "npm run gen && tsc --noEmit -p ."
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "6.0.7"
  }
}
